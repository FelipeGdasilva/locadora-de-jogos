generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Jogo {
  id          Int       @id @default(autoincrement())
  titulo      String    @db.VarChar(100)
  plataforma  String    @db.VarChar(50)
  precoDiaria Decimal   @map("preco_diaria") @db.Decimal(10, 2)
  disponivel  Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  locacoes    Locacao[]

  @@map("jogos")
}

model Cliente {
  id       Int       @id @default(autoincrement())
  nome     String    @db.VarChar(100)
  email    String    @unique @db.VarChar(100)
  telefone String?   @db.VarChar(20)
  locacoes Locacao[]

  @@map("clientes")
}

model Locacao {
  id            Int       @id @default(autoincrement())
  clienteId     Int       @map("cliente_id")
  jogoId        Int       @map("jogo_id")
  dataLocacao   DateTime  @default(now()) @map("data_locacao")
  dataDevolucao DateTime? @map("data_devolucao")
  valorTotal    Decimal?  @map("valor_total") @db.Decimal(10, 2)

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  jogo   Jogo   @relation(fields: [jogoId], references: [id], onDelete: Restrict)

  @@map("locacoes")
}